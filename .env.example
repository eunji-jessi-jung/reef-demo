# Copy these into the Vercel project's Environment Variables.
# ANTHROPIC_API_KEY is set by a human in the dashboard and never committed.

ANTHROPIC_API_KEY=
# REEF_MODEL=claude-sonnet-5          # default; claude-haiku-4-5-20251001 is ~half the cost
# REEF_REQUEST_BUDGET=400             # requests per instance before falling back to canned answers
# REEF_RATE_LIMIT_PER_MIN=5           # requests per IP per minute; in-memory, per instance
# REEF_ALLOWED_ORIGINS=https://eunji-jessi-jung.github.io,http://localhost:4173
